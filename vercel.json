{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd Frontend/corvus-mobile && npm install && npm run build",
  "outputDirectory": "Frontend/corvus-mobile/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

